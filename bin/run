#!/usr/bin/env bash
# corral — orchestration SSOT autonomous rig (bin/run).
#
# Verifies the multi-agent orchestration loop boots non-destructively:
# invokes the Corral CLI in --dry-run so no live fleet coordination is
# touched (no ticket execution, no merges, no proposal writes).
#
# Usage:
#   bin/run                dry-run with a trivial safe prompt
#   bin/run "your prompt"  dry-run with a specific prompt
#
# For live orchestration, run the CLI normally (e.g. `bun run src/cli/index.ts
# "prompt"`); this rig exists to confirm the loop is runnable without breaking
# the live fleet, and pairs with bin/check.
set -euo pipefail
cd "$(dirname "$0")/.."

prompt="${1:-Verify the corral rig boots the orchestration loop without side effects}"

# Resolve the real bun by absolute path: the estate bash-2s-shim mis-fires on
# sub-10ms bun invocations (RUN_FAST_ACTIVE unbound). Use the real binary.
cmd_bun="$(readlink -f "$(command -v bun 2>/dev/null || true)" 2>/dev/null || true)"
for cand in /home/toxic/.bun/bin/bun "$cmd_bun" /usr/local/bin/bun /usr/bin/bun; do
  [ -x "$cand" ] && { REAL_BUN="$cand"; break; }
done
[ -n "${REAL_BUN:-}" ] || { echo "FAIL: bun not found"; exit 1; }

echo "== corral run: dry-run orchestrator (no live side effects) =="
if "$REAL_BUN" run src/cli/index.ts --dry-run --skip-questions "$prompt" >/tmp/corral-run.log 2>&1; then
    echo "OK: corral CLI dry-run exited 0"
    grep -viE "\[delendai\]|proposal index|commit-policy|will stay|Slices|This notice|^$" /tmp/corral-run.log | tail -5 || true
    exit 0
else
    echo "FAIL: corral CLI dry-run exited nonzero (see /tmp/corral-run.log)"
    tail -25 /tmp/corral-run.log
    exit 1
fi