{
  "name": "@smthrs/db",
  "version": "0.35.0",
  "description": "SQLite and Drizzle persistence adapter for Smithers workflows",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./runState": {
      "import": "./src/runState.js",
      "default": "./src/runState.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "effect": "4.0.0-beta.105",
    "zod": "^4.4.3",
    "@smthrs/errors": "0.35.0",
    "@smthrs/graph": "0.35.0",
    "@smthrs/scheduler": "0.35.0",
    "@smthrs/observability": "0.35.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.6",
    "@types/bun": "latest",
    "pg": "^8.22.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}