{
  "name": "@smthrs/engine",
  "version": "0.35.0",
  "description": "Concrete Smithers workflow execution engine",
  "type": "module",
  "sideEffects": [
    "./src/workflow-module-resolution.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js",
      "default": "./src/browser.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.105",
    "@effect/platform-node-shared": "4.0.0-beta.105",
    "@effect/sql-sqlite-bun": "4.0.0-beta.105",
    "ai": "^7.0.10",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.105",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "@smthrs/agents": "0.35.0",
    "@smthrs/components": "0.35.0",
    "@smthrs/db": "0.35.0",
    "@smthrs/driver": "0.35.0",
    "@smthrs/errors": "0.35.0",
    "@smthrs/observability": "0.35.0",
    "@smthrs/react-reconciler": "0.35.0",
    "@smthrs/sandbox": "0.35.0",
    "@smthrs/scheduler": "0.35.0",
    "@smthrs/scorers": "0.35.0",
    "@smthrs/time-travel": "0.35.0",
    "@smthrs/tool-context": "0.35.0",
    "@smthrs/vcs": "0.35.0",
    "@smthrs/graph": "0.35.0"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.6",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.105",
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test --timeout=60000 --max-concurrency=1 tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}