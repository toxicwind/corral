{
  "name": "@smthrs/gateway-ui",
  "version": "0.35.0",
  "description": "Reusable React components for Smithers Gateway UIs — drop-in run lists, approval panels, node trees, event logs and launch controls built on @smthrs/gateway-react hooks. Use these to build a custom workflow UI under .smithers/ui/<workflow>.tsx.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styleguide-css": {
      "types": "./src/styleguide-css.ts",
      "import": "./src/styleguide-css.ts",
      "default": "./src/styleguide-css.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "dagre": "^0.8.5",
    "@smthrs/gateway-client": "0.35.0",
    "@smthrs/gateway-react": "0.35.0",
    "@smthrs/ui-styleguide": "0.35.0",
    "@smthrs/ui": "0.35.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "latest",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "node ../../node_modules/tsup/dist/cli-default.js --dts-only",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout=60000 tests"
  }
}