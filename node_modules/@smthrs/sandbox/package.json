{
  "name": "@smthrs/sandbox",
  "version": "0.35.0",
  "description": "Sandbox bundle, execution, and transport integration for Smithers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./SandboxHandle": {
      "types": "./src/SandboxHandle.ts"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "effect": "4.0.0-beta.105",
    "@smthrs/db": "0.35.0",
    "@smthrs/driver": "0.35.0",
    "@smthrs/errors": "0.35.0",
    "@smthrs/scheduler": "0.35.0",
    "@smthrs/observability": "0.35.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('src/index.d.ts',{force:true})\" && tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}