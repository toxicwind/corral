{
  "name": "@smthrs/components",
  "version": "0.35.0",
  "description": "React components for Smithers workflows",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "bippy": "^0.5.42",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "@smthrs/agents": "0.35.0",
    "@smthrs/db": "0.35.0",
    "@smthrs/driver": "0.35.0",
    "@smthrs/errors": "0.35.0",
    "@smthrs/graph": "0.35.0",
    "@smthrs/memory": "0.35.0",
    "@smthrs/react-reconciler": "0.35.0",
    "@smthrs/observability": "0.35.0",
    "@smthrs/scheduler": "0.35.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@types/bun": "latest",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.105",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -f src/index.d.ts && tsup --dts-only"
  }
}