{
  "name": "@smthrs/cli",
  "version": "0.35.0",
  "description": "Smithers command-line interface, MCP server, and local workflow tools",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "ui-dist/"
  ],
  "dependencies": {
    "@clack/core": "^1.4.2",
    "@clack/prompts": "^1.6.0",
    "@mdx-js/esbuild": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pierre/diffs": "^1.2.11",
    "@toon-format/toon": "2.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.105",
    "esbuild": "^0.28.1",
    "incur": "^0.4.10",
    "picocolors": "^1.1.1",
    "react": "^19.2.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@smthrs/accounts": "0.35.0",
    "@smthrs/agents": "0.35.0",
    "@smthrs/db": "0.35.0",
    "@smthrs/components": "0.35.0",
    "@smthrs/devtools": "0.35.0",
    "@smthrs/engine": "0.35.0",
    "@smthrs/driver": "0.35.0",
    "@smthrs/errors": "0.35.0",
    "@smthrs/graph": "0.35.0",
    "@smthrs/herdr": "0.35.0",
    "@smthrs/integrations": "0.35.0",
    "@smthrs/memory": "0.35.0",
    "@smthrs/openapi": "0.35.0",
    "@smthrs/protocol": "0.35.0",
    "@smthrs/scheduler": "0.35.0",
    "@smthrs/observability": "0.35.0",
    "@smthrs/scorers": "0.35.0",
    "@smthrs/time-travel": "0.35.0",
    "@smthrs/vcs": "0.35.0",
    "@smthrs/server": "0.35.0",
    "@smthrs/usage": "0.35.0",
    "smthrs": "0.35.0"
  },
  "peerDependencies": {
    "@smthrs/review": "0.35.0",
    "@smthrs/tui": "0.35.0"
  },
  "peerDependenciesMeta": {
    "@smthrs/review": {
      "optional": true
    },
    "@smthrs/tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3",
    "@smthrs/review": "0.35.0",
    "@smthrs/tui": "0.35.0"
  },
  "scripts": {
    "test": "bun test --timeout=120000 --max-concurrency=1 tests/monitor-shell-controls.test.tsx && bun ./scripts/run-test-shards.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node --max-old-space-size=8192 ../../node_modules/tsup/dist/cli-default.js --dts-only",
    "build:ui": "node scripts/build-ui.mjs"
  }
}