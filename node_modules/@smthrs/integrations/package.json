{
  "name": "@smthrs/integrations",
  "version": "0.35.0",
  "description": "External service integrations (webhook + polling event sources) for Smithers workflows",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./telegram": {
      "types": "./src/telegram.d.ts",
      "import": "./src/telegram.js",
      "default": "./src/telegram.js"
    },
    "./github": {
      "types": "./src/github.d.ts",
      "import": "./src/github.js",
      "default": "./src/github.js"
    },
    "./linear": {
      "types": "./src/linear.d.ts",
      "import": "./src/linear.js",
      "default": "./src/linear.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "effect": "4.0.0-beta.105",
    "react": "^19.2.7",
    "zod": "4.4.3",
    "@smthrs/components": "0.35.0",
    "@smthrs/db": "0.35.0",
    "@smthrs/engine": "0.35.0",
    "@smthrs/errors": "0.35.0",
    "@smthrs/observability": "0.35.0",
    "@smthrs/react-reconciler": "0.35.0",
    "@smthrs/scheduler": "0.35.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-orm": "^0.45.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../scripts/clean-dts.mjs src && tsup"
  }
}