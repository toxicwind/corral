{
  "name": "@smthrs/testing",
  "version": "0.35.0",
  "description": "Workflow testing helpers for Smithers",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./runScenario": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "fixtures/",
    "scripts/"
  ],
  "dependencies": {
    "effect": "4.0.0-beta.105",
    "zod": "^4.4.3",
    "@smthrs/components": "0.35.0",
    "@smthrs/driver": "0.35.0",
    "@smthrs/graph": "0.35.0",
    "@smthrs/db": "0.35.0",
    "@smthrs/engine": "0.35.0",
    "@smthrs/react-reconciler": "0.35.0",
    "@smthrs/herdr": "0.35.0",
    "@smthrs/scheduler": "0.35.0"
  },
  "peerDependencies": {
    "koffi": "^2.16.2",
    "smthrs": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "koffi": {
      "optional": true
    },
    "smthrs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "koffi": "^2.16.2",
    "typescript": "~6.0.3",
    "smthrs": "0.35.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dts.mjs src && tsup",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test tests --path-ignore-patterns '**/scenarios/**' && bun test tests/scenarios --timeout 30000",
    "campaign": "bun scripts/core-campaign.mjs",
    "campaign:herdr": "bun scripts/core-campaign.mjs --herdr --watch-pack --fresh"
  }
}