{
  "name": "@smthrs/scorers",
  "version": "0.35.0",
  "description": "Smithers scorer definitions, execution, aggregation, and persistence helpers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./metrics": {
      "types": "./src/index.d.ts",
      "import": "./src/metrics.js",
      "default": "./src/metrics.js"
    },
    "./schema": {
      "types": "./src/index.d.ts",
      "import": "./src/schema.js",
      "default": "./src/schema.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.105",
    "typescript": "~6.0.3",
    "zod": "^4.4.3",
    "@smthrs/agents": "0.35.0",
    "@smthrs/db": "0.35.0",
    "@smthrs/errors": "0.35.0",
    "@smthrs/observability": "0.35.0",
    "@smthrs/graph": "0.35.0",
    "@smthrs/scheduler": "0.35.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test tests ../../evals/suites/authoring-side-effects/sideEffectFixtures.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}